# Clés API pour JobHunter-AI
# Créez un fichier .env à partir de ce modèle et remplissez vos clés.

GEMINI_API_KEY=votre_cle_ici
OPENAI_API_KEY=votre_cle_ici
ADZUNA_APP_ID=votre_identifiant_adzuna
ADZUNA_APP_KEY=votre_cle_adzuna

# France Travail API (optionnel, fallback public si non configuré)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Webhook pour notifications (Telegram/Slack)
WEBHOOK_URL=

# Port HTTP local ou cloud (optionnel, 4173 par défaut)
PORT=4173

# PostgreSQL (production / Docker)
# DATABASE_URL=postgresql://user:password@db:5432/jobhunter
# PG_SSL=false

# JWT Secret pour l'authentification
JWT_SECRET=changez-ce-secret-en-production
