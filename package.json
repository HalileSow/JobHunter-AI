{
  "name": "jobhunter-ai",
  "version": "1.0.0",
  "description": "Plateforme professionnelle pour trouver un emploi en Europe",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node site/server.mjs",
    "postinstall": "npm --prefix automation ci && npm --prefix site ci",
    "test": "npm --prefix automation test && npm --prefix site test",
    "test:automation": "npm --prefix automation test",
    "test:site": "npm --prefix site test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "knex": "^3.1.0"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.0.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.4.0",
    "pg": "^8.13.0",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "bcrypt@6.0.0": true
  }
}
